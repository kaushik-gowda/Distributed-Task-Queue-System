# FastAPI Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1
DEBUG=False

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Database Configuration
# For Local Testing: sqlite:///tasks.db
# For Production/SaaS: postgresql://user:password@host:5432/taskdb
DB_PATH=sqlite:///tasks.db
DB_ECHO=False

# Worker Configuration
WORKER_ENABLED=True
WORKER_NUM=2
QUEUE_NAME=task_queue
TASK_TIMEOUT=300
MAX_RETRIES=3
BACKOFF_FACTOR=2.0
POLL_INTERVAL=1.0

# Logging
LOG_LEVEL=INFO
