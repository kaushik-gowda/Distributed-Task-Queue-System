# Production Environment Configuration
# Copy this to .env.production and customize for your environment

# ============================================================================
# API Server Configuration
# ============================================================================
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
DEBUG=False

# ============================================================================
# Redis Configuration (Production)
# ============================================================================
REDIS_HOST=redis.internal.example.com
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=YOUR_SECURE_REDIS_PASSWORD_HERE
# Optional: Use Redis Sentinel or Cluster
# REDIS_SENTINEL_HOSTS=sentinel1:26379,sentinel2:26379,sentinel3:26379
# REDIS_SENTINEL_SERVICE_NAME=mymaster

# ============================================================================
# Database Configuration (Production)
# ============================================================================
# For production, consider PostgreSQL instead of SQLite
# DB_TYPE=postgres
# DB_URL=postgresql://user:password@db.internal.example.com:5432/task_queue
# For SQLite (development only):
DB_PATH=/data/tasks.db
DB_ECHO=False

# ============================================================================
# Worker Configuration
# ============================================================================
WORKER_ENABLED=True
WORKER_NUM=4
QUEUE_NAME=task_queue
TASK_TIMEOUT=600
MAX_RETRIES=3
BACKOFF_FACTOR=2.0
POLL_INTERVAL=0.5

# ============================================================================
# Logging (Production)
# ============================================================================
LOG_LEVEL=INFO
# Optional: Send logs to external service
# LOG_SERVICE=datadog|stackdriver|splunk
# LOG_SERVICE_KEY=your_api_key_here

# ============================================================================
# Security (Production)
# ============================================================================
# Enable HTTPS/SSL
USE_HTTPS=True
SSL_CERT_PATH=/etc/certs/server.crt
SSL_KEY_PATH=/etc/certs/server.key

# API Authentication (optional)
ENABLE_API_KEY_AUTH=False
API_KEY_SECRET=your_secret_key_here

# CORS configuration
ALLOWED_ORIGINS=https://app.example.com,https://api.example.com

# ============================================================================
# Monitoring & Alerts (Optional)
# ============================================================================
ENABLE_METRICS=True
METRICS_PORT=9090

# Sentry Error Tracking
SENTRY_DSN=

# Health Check Configuration
HEALTH_CHECK_INTERVAL=30

# ============================================================================
# Rate Limiting (Optional)
# ============================================================================
ENABLE_RATE_LIMITING=True
RATE_LIMIT_REQUESTS=1000
RATE_LIMIT_PERIOD=3600

# ============================================================================
# Performance Tuning
# ============================================================================
# Connection pooling
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40
REDIS_POOL_SIZE=50

# Cache configuration
ENABLE_CACHING=True
CACHE_TTL=300

# ============================================================================
# Deployment Environment
# ============================================================================
ENVIRONMENT=production
DEPLOYMENT_REGION=us-east-1
SERVICE_NAME=task-queue-api
